# ============================================================================
# Portfolio API — environment (docs/API.md §4)
#
# Copy to server/.env and edit. Real environment variables win over this file,
# so `PORT=9000 node src/index.js` behaves as expected. `server/.env` is
# git-ignored; this example is not.
# ============================================================================

# ---------------------------------------------------------------- http ------
# Port the API listens on. The web dev server proxies /api here.
PORT=8787

# ------------------------------------------------------------- database -----
# `sqlite` (default) or `postgres`.
#
#   sqlite   → one file, no server to run. Local development, tests, and
#              self-hosted deployments. Uses the `node:sqlite` module built into
#              Deno (>= 2.2) and Node (>= 22.5), so there is no native addon to
#              compile and `npm install` no longer needs a toolchain.
#   postgres → required on Deno Deploy. Its instances have isolated, ephemeral
#              disks: a SQLite file there would be invisible to the other
#              instances and would not survive a restart. See docs/DENO-PORT.md.
DB_DRIVER=sqlite

# --- sqlite only -------------------------------------------------------------
# Database file. Relative paths resolve against server/ (not the cwd); the
# directory is created on demand. Recreate it with `npm run seed` / `reset`.
DATABASE_FILE=./data/app.db

# --- postgres only -----------------------------------------------------------
# Connection string. Leave it empty and `pg` falls back to the standard PGHOST /
# PGPORT / PGUSER / PGPASSWORD / PGDATABASE variables, which Deno Deploy injects
# on its own once a database is attached to the app.
# DATABASE_URL=postgresql://user:password@host:5432/portfolio
#
# Apply schema.postgres.sql on boot. Turn this off once a migration step owns the
# schema — on Deno Deploy, use the app's Pre-Deploy Command
# (`deno run --allow-all server/src/bootstrap.js`, see docs/DENO-PORT.md §6.3).
# DB_AUTO_SCHEMA=1
#
# Connection pool size, and TLS. `require` verifies the server certificate;
# `no-verify` accepts a self-signed one. Empty leaves the decision to `pg` and to
# whatever `sslmode` the connection string carries.
# PG_POOL_MAX=5
# PGSSL=require

# ---------------------------------------------------- deploy bootstrap -------
# Read by src/bootstrap.js, which is meant to run as the Deno Deploy Pre-Deploy
# Command. It seeds a database that is still empty and then makes sure this
# account exists, so a fresh deploy has a way in without a shell.
#
# Leave DEMO_OWNER_PASSWORD empty and the account step is skipped with a warning:
# there is deliberately no default password that could ship by accident. Mark the
# value as a secret in the Deno Deploy dashboard — build logs are kept.
DEMO_OWNER_EMAIL=demo@portfolio.test
# DEMO_OWNER_PASSWORD=
# Demo name; defaults to the local part of DEMO_OWNER_EMAIL.
# DEMO_OWNER_NAME=
# DEMO_OWNER_ROLE=owner
# Set to 1 to also overwrite the password of an account that already exists.
# Without it an edited name or password survives the next deploy untouched.
# DEMO_OWNER_RESET_PASSWORD=

# How long a login lasts. Sessions are revocable and stored hashed.
SESSION_TTL_DAYS=14

# HMAC-SHA256 key for the `sid` and `wx_state` cookies. CHANGE THIS: with the
# shipped default anyone can mint a valid cookie signature.
COOKIE_SECRET=change-me

# Set to 1 only on a machine that is not reachable from the internet.
# Enables POST /api/auth/dev-login, which signs in without a password.
# The route 404s whenever this is not exactly 1/true/yes/on.
AUTH_DEV=0

# Add `Secure` to every cookie we set. Turn on behind HTTPS.
# HTTPS=0

# ----------------------------------------------------------------- oss ------
# `mock`     → signing returns upload.url = /api/uploads/mock, so the admin UI
#              can be exercised offline. Nothing is stored.
# `aliyun`   → a real OSS V1 POST policy (needs the two secrets below).
OSS_PROVIDER=mock
OSS_BUCKET=portfolio
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Public CDN prefix used to build `publicUrl`; the OSS bucket host is used when
# this is empty. `mock` falls back to https://cdn.example.com/uploads/<key>.
OSS_PUBLIC_BASE=https://cdn.example.com
# Object-key prefix inside the bucket.
OSS_UPLOAD_DIR=uploads
# Hard ceiling advertised to the browser and enforced in the POST policy: 25 MiB.
OSS_MAX_BYTES=26214400

# --------------------------------------------------------------- wechat -----
# qrconnect = 网站应用 (snsapi_login) | mp = 公众号 (snsapi_userinfo)
WECHAT_MODE=qrconnect
# Leave WECHAT_MOCK unset: it follows WECHAT_APP_ID on its own —
#   WECHAT_APP_ID empty → mock ON   (the usual dev case, no credentials needed)
#   WECHAT_APP_ID set   → mock OFF  (the callback really calls api.weixin.qq.com)
# Setting it here would survive into a configured deployment and silently keep
# faking logins, which is exactly what the automatic rule prevents. Opt in
# explicitly (`WECHAT_MOCK=1`) only when you have an app id but want to stay
# offline — mock profiles are `mock-openid-<code>`, deterministic per code.
# WECHAT_MOCK=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Must be an absolute URL registered in the 开放平台 console.
WECHAT_REDIRECT_URI=http://localhost:8787/api/auth/wechat/callback
# Where the callback sends the browser afterwards. Only same-origin paths
# (starting with a single "/") are honoured — `?redirect=` can never be turned
# into an open redirect.
WECHAT_SUCCESS_REDIRECT=/admin
# Role given to an account created on first WeChat login.
WECHAT_DEFAULT_ROLE=author
