{
  "name": "@portfolio/server",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "description": "Portfolio API — Express, RBAC, OSS signing, WeChat login; SQLite or Postgres",
  "scripts": {
    "dev": "deno run --allow-all --watch src/index.js",
    "start": "deno run --allow-all src/index.js",
    "seed": "deno run --allow-all src/seed.js",
    "reset": "deno run --allow-all src/seed.js --reset",
    "cli": "deno run --allow-all src/cli.js",
    "dev:node": "node --watch src/index.js",
    "start:node": "node src/index.js",
    "seed:node": "node src/seed.js",
    "reset:node": "node src/seed.js --reset",
    "cli:node": "node src/cli.js"
  },
  "dependencies": {
    "express": "^4.21.1",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10"
  }
}
