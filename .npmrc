# The public npm registry is unreachable from this network (requests to
# registry.npmjs.org time out; the mirror answers in ~1s).
#
# This file only affects installs *inside this repository* — it does not touch
# your global npm config. Delete it (or point `registry` back at npmjs.org) if
# you are on a network where the public registry is fast.
registry=https://registry.npmmirror.com

# better-sqlite3 ships prebuilt binaries; pull them from the same mirror so the
# install never falls back to compiling from source.
better_sqlite3_binary_host_mirror=https://npmmirror.com/mirrors/better-sqlite3

# native builds, if they ever happen, should also fetch headers from the mirror
disturl=https://npmmirror.com/mirrors/node
