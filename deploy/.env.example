# Deployment environment — copy to the repo root as `.env`:
#
#   cp deploy/.env.example .env
#
# `docker compose` reads `.env` automatically and passes it to both containers.

# ---- Caddy ------------------------------------------------------------------
# The public hostname. Must resolve (A record) to this server before the first
# boot, otherwise the certificate request fails.
DOMAIN=portfolio.example.com

# ---- the app ----------------------------------------------------------------
PORT=8787
DATABASE_FILE=/data/app.db
STATIC_DIR=/app/web/dist

# Signs the session cookie. Generate one and keep it secret:
#   openssl rand -base64 48
COOKIE_SECRET=replace-me-with-a-long-random-string

# 1 => mark cookies Secure (required behind HTTPS, i.e. behind Caddy)
HTTPS=1

# Never leave this on in production: it allows password-less sign-in as any
# seeded account.
AUTH_DEV=0

# ---- OSS (images live on object storage; this server stores URLs only) -------
# mock keeps the admin's upload flow working with no credentials at all.
OSS_PROVIDER=mock
OSS_BUCKET=portfolio
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE=https://cdn.example.com

# ---- WeChat login -----------------------------------------------------------
# qrconnect = 网站应用 (scan a QR code) · mp = 公众号
WECHAT_MODE=qrconnect

# Leave this empty until the domain is registered with WeChat. While it is empty,
# mock mode is automatic, so the whole login flow (and `scripts/smoke.mjs`) works
# with no credentials at all.
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Must be a domain registered in the 开放平台 console, over HTTPS:
WECHAT_REDIRECT_URI=https://portfolio.example.com/api/auth/wechat/callback
WECHAT_SUCCESS_REDIRECT=/admin
WECHAT_DEFAULT_ROLE=author

# ---- WECHAT_MOCK: leave this unset ------------------------------------------
# Mock follows WECHAT_APP_ID automatically:
#   * WECHAT_APP_ID empty → mock ON   (a fresh deploy, and offline development)
#   * WECHAT_APP_ID set   → mock OFF  (the callback really calls api.weixin.qq.com)
#
# Do NOT set WECHAT_MOCK=0 while WECHAT_APP_ID is empty: the callback then fails
# with `wechat_not_configured` (HTTP 500), because it tries to reach WeChat with
# no credentials. Set WECHAT_MOCK=1 explicitly only if you have an app id but want
# to keep testing the flow offline.
# WECHAT_MOCK=
