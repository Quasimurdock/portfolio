# Caddy in front of the app: automatic HTTPS (Let's Encrypt), automatic HTTP→HTTPS
# redirect, and gzip/zstd compression — none of which the Node process does itself.
#
# DOMAIN comes from the .env file that docker compose passes to this container.
# It must already point at this server (an A record), and ports 80/443 must be
# open, or the certificate request will fail.

{$DOMAIN} {
	encode zstd gzip

	# Everything — the API under /api and the site for every other path — is
	# served by the app container on one origin, which is what keeps the session
	# cookie same-site.
	reverse_proxy app:8787
}
