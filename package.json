{
  "name": "portfolio",
  "private": true,
  "version": "2.0.0",
  "description": "Photographic portfolio — public site + studio back office (Vite/Vue 3; Deno + Express on SQLite or Postgres)",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm --workspace server run dev",
    "dev:web": "npm --workspace web run dev",
    "build": "npm --workspace web run build",
    "preview": "npm --workspace web run preview",
    "seed": "npm --workspace server run seed",
    "reset:db": "npm --workspace server run reset",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "npm --workspace web run typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
